# AI-generated (Claude, by Anthropic). Tested on one GPD Win Max 2 G1619-05; review before use. No warranty.
# Let Steam open the hidraw node of InputPlumber's virtual HORIPAD STEAM (uhid,
# 0f0d:01ab or 0f0d:0196). Without it Steam falls back to evdev and gets no gyro.
# steam-devices only grants this for Valve (28de) devices.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", KERNELS=="0003:0F0D:01AB.*|0003:0F0D:0196.*", MODE="0660", TAG+="uaccess"
